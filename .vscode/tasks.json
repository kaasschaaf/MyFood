{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Kost: Start local server",
			"detail": "npm start — serves the app locally with `npx serve`",
			"type": "shell",
			"command": "npm start",
			"isBackground": true,
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			},
			"problemMatcher": {
				"owner": "myfood-serve",
				"pattern": {
					"regexp": "^\\s*(.+?):(\\d+):(\\d+):\\s+(error|warning)\\s+(.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"severity": 4,
					"message": 5
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "(>\\s*\\S+@|Serving!)",
					"endsPattern": "(Accepting connections|Local:\\s+http)"
				}
			}
		}
	]
}